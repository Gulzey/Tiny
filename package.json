{
  "name": "tiny",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "seed": "node --env-file-if-exists=.env server/seed.mjs",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "start": "node scripts/start.mjs",
    "desktop": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:server": "node scripts/build-server.mjs",
    "package:release": "node scripts/package-release.mjs",
    "release": "npm run build:desktop && npm run build:server && npm run package:release",
    "measure:idle": "node scripts/smoke-desktop.mjs --measure-idle",
    "test": "node --test --test-timeout=15000 tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:server-exe": "node scripts/smoke-server.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.9.4",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
