# Copy to .env only if you want to change the defaults.
# Loopback means only this PC can reach the server.
TINY_HOST=127.0.0.1
TINY_PORT=8787
TINY_DB=data/tiny.sqlite
# Password authentication and registration controls.
TINY_LOCAL_AUTH=true
TINY_REGISTRATION_ENABLED=true

# Accept X-Forwarded-For only from a loopback reverse proxy such as local Caddy.
# Never enable this when untrusted clients can reach the Node port directly.
# TINY_TRUST_PROXY=loopback

# Optional comma-separated browser origins. When set, REPLACES the default
# allowlist. Keep your frontend's origin plus Tauri's origin if using desktop.
# TINY_ALLOWED_ORIGINS=http://127.0.0.1:1420,http://127.0.0.1:8787,http://tauri.localhost,https://tauri.localhost

# Calls across networks need STUN and a reachable TURN fallback. TURN credentials
# are generated per authenticated user and expire; the shared secret never goes
# to the frontend. It must match coturn's static-auth-secret.
# TINY_STUN_URLS=stun:tinybros.duckdns.org:3478
# TINY_TURN_URLS=turn:tinybros.duckdns.org:3478?transport=udp,turn:tinybros.duckdns.org:3478?transport=tcp
# TINY_TURN_SECRET=replace-with-at-least-32-random-characters
# TINY_TURN_CREDENTIAL_TTL=3600
