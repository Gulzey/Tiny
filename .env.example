# Copy to .env only if you want to change the defaults.
# Loopback means only this PC can reach the server.
TINY_HOST=127.0.0.1
TINY_PORT=8787
TINY_DB=data/tiny.sqlite
# false blocks new local sign-ins; existing sessions remain valid until logout/expiry.
TINY_LOCAL_AUTH=true

# Optional comma-separated browser origins. When set, REPLACES the default
# allowlist. Keep your frontend's origin plus Tauri's origin if using desktop.
# TINY_ALLOWED_ORIGINS=http://127.0.0.1:1420,http://127.0.0.1:8787,http://tauri.localhost,https://tauri.localhost

# No external STUN/TURN service is contacted by default.
# Use short-lived TURN credentials for a publicly deployed version.
# This configuration is sent to authenticated clients AND /api/config;
# never place provider management/API secrets here.
TINY_ICE_SERVERS=[]
# Example using YOUR OWN TURN service (not working example credentials):
# TINY_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"test-user","credential":"replace-me"}]
