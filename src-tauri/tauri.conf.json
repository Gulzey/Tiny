{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiny",
  "version": "0.2.0",
  "identifier": "app.tiny.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tiny",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "useHttpsScheme": false,
        "backgroundColor": "#08090b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxODFCOTkxQThDNTU0REQKUldUZFZNV29rYm1CY1FRUVBnSUQ4cEJjYm5QQ25DNGVpWVdBdFl0MlhxVDMxSmUxbC9yWmgzbHEK",
      "endpoints": [
        "https://github.com/Gulzey/Tiny-Releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
