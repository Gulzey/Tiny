# Optional: copy this file to tiny-server.env beside Tiny-Server.exe.
# Double-click Tiny-Server.exe after editing. Restart after changing settings.

# This PC only. Use 0.0.0.0 for trusted LAN testing after configuring the firewall.
TINY_HOST=127.0.0.1
TINY_PORT=8787

# Saved data defaults to %LOCALAPPDATA%\Tiny Server\tiny.sqlite.
# An explicit relative path is resolved beside Tiny-Server.exe.
# TINY_DB=data/tiny.sqlite

# Local test accounts can be created in Tiny. No demo accounts are added by default.
# false prevents new test sign-ins; it does not revoke existing sessions.
TINY_LOCAL_AUTH=true
TINY_REGISTRATION_ENABLED=true

# Optional comma-separated list. When set, replaces every default allowed origin.
# Keep http://tauri.localhost for this packaged Windows client.
# Keep the https origin too if using the earlier HTTPS-origin client build.
# TINY_ALLOWED_ORIGINS=http://tauri.localhost,https://tauri.localhost,http://127.0.0.1:1420

# Optional self-hosted coturn. The shared secret remains server-side and must
# match coturn's static-auth-secret. Clients receive one-hour HMAC credentials.
# TINY_STUN_URLS=stun:turn.example.com:3478
# TINY_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# TINY_TURN_SECRET=replace-with-at-least-32-random-characters
# TINY_TURN_CREDENTIAL_TTL=3600

# Public/remote hosting also needs a reachable address, HTTPS/WSS, proper accounts,
# and often TURN for calls. Tiny does not configure these services automatically.
